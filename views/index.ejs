<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Library Management System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="header">
    <h1>📚 Library Management System</h1>
    <p>Manage books and users easily</p>
  </header>

  <main class="home-container">
    <div class="card">
      <h2>📖 View Books</h2>
      <p>See all books available in the library</p>
      <a href="/books/view" class="btn">View Books</a>
    </div>

    <div class="card">
      <h2>➕ Add Book</h2>
      <p>Add new books to the library</p>
      <a href="/books/add" class="btn">Add Book</a>
    </div>

    <div class="card">
      <h2>👤 Users</h2>
      <p>Manage library users</p>
      <a href="/users/view" class="btn">View Users</a>
    </div>
  </main>

</body>
</html>
