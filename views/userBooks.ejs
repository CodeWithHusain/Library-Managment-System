<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Borrowed Books</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <div class="container">

        <h1>📚 Borrowed Books</h1>

        <table>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Author</th>
                <th>Issue Date</th>
            </tr>

            <% if (books.length===0) { %>
                <tr>
                    <td colspan="4" style="text-align:center;">
                        No books currently borrowed
                    </td>
                </tr>
                <% } %>

                    <% books.forEach((book, index)=> { %>
                        <tr>
                            <td>
                                <%= index + 1 %>
                            </td>
                            <td>
                                <%= book.title %>
                            </td>
                            <td>
                                <%= book.author %>
                            </td>
                            <td>
                                <%= book.issue_date %>
                            </td>
                        </tr>
                        <% }) %>
        </table>

        <br>
        <a href="/users/view">⬅ Back to Users</a>

    </div>

</body>

</html>